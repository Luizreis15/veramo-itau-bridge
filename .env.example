# Credenciais Itaú OAuth
ITAU_CLIENT_ID=00000000-0000-0000-0000-000000000000
ITAU_CLIENT_SECRET=00000000-0000-0000-0000-000000000000

# PEM como string — incluir \n reais (não escapados)
# Para copiar do arquivo: cat itau_certificado.crt | pbcopy
ITAU_CERT_PEM="-----BEGIN CERTIFICATE-----
MIIDxxxxxx...
-----END CERTIFICATE-----"

ITAU_KEY_PEM="-----BEGIN PRIVATE KEY-----
MIIExxxxxx...
-----END PRIVATE KEY-----"

# Endpoint OAuth (default já correto para produção)
ITAU_TOKEN_URL=https://sts.itau.com.br/api/oauth/token

# Token de proteção do bridge — gere com: openssl rand -hex 32
BRIDGE_ACCESS_TOKEN=troque-por-um-token-aleatorio-seguro

# Porta do servidor (opcional)
PORT=3001
